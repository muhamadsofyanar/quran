# @phase TQ-05 — copy to .env for local/Coolify production configuration.
NODE_ENV=production
PORT=3000
APP_URL=https://taysriulqurani.id
APP_NAME=Taysriul Qur'ani

# Persistent data. Mount /app/data as a Coolify persistent volume.
TQ_DATA_DIR=/app/data
TQ_MAX_UPLOAD_BYTES=536870912
TQ_REQUIRE_DATABASE=true
TQ_ALLOW_SIGNUP=true
TQ_SESSION_DAYS=14
TQ_IP_HASH_SALT=replace-with-random-64-characters
TQ_ADMIN_TOKEN=replace-with-random-64-characters
TQ_ALLOWED_ORIGINS=https://taysriulqurani.id

# Validated 114-surah / 6,236-ayah Uthmani corpus cache.
TQ_QURAN_AUTO_SYNC=true
TQ_QURAN_SOURCE_URL=https://api.alquran.cloud/v1/quran/quran-uthmani
# Additional custom content sources (optional). Built-in QuranEnc sources work without configuration.
TQ_QURAN_CONTENT_SOURCES_JSON=
# Discover the live QuranEnc multilingual catalog without redeploying when new editions appear.
TQ_QURANENC_DISCOVERY=true
# Refresh cached translation/tafsir surahs after this many seconds (default 7 days).
TQ_CONTENT_CACHE_SECONDS=604800

# Automatic Qur'an recitation catalog and per-ayah cache. No API key is required.
TQ_QURAN_AUDIO_PROVIDER=alquran.cloud
TQ_QURAN_AUDIO_API_URL=https://api.alquran.cloud/v1
TQ_QURAN_AUDIO_CDN_URL=https://cdn.islamic.network/quran/audio
TQ_QURAN_AUDIO_CATALOG_SECONDS=21600
TQ_QURAN_AUDIO_DOWNLOAD_CONCURRENCY=4
TQ_QURAN_AUDIO_WORKER_CONCURRENCY=1
TQ_QURAN_AUDIO_JOB_ATTEMPTS=3
TQ_QURAN_AUDIO_MAX_BYTES=536870912

# Local Compose service by default; replace with another compatible endpoint if needed.
TQ_TRANSCRIBE_URL=http://transcriber:8000/v1/audio/transcriptions
TQ_TRANSCRIBE_TOKEN=
TQ_TRANSCRIBE_MODEL=small

# Local faster-whisper service. CPU int8 is the safe default.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=5

# FFmpeg quality/speed controls.
TQ_FFMPEG_PRESET=medium
TQ_FFMPEG_CRF=20

# Production data services. The Compose file builds these URLs internally.
POSTGRES_PASSWORD=replace-with-random-strong-password
DATABASE_URL=postgresql://taysriul:replace-with-password@postgres:5432/taysriul_qurani
TQ_DB_POOL_SIZE=10
TQ_DB_SSL=disable
REDIS_PASSWORD=replace-with-random-strong-password
REDIS_URL=redis://:replace-with-password@redis:6379/0

# S3-compatible storage (embedded MinIO for initial self-hosting or external S3/R2).
TQ_STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=taysriul-qurani-media
S3_ACCESS_KEY_ID=replace-with-minio-user
S3_SECRET_ACCESS_KEY=replace-with-minio-password
S3_FORCE_PATH_STYLE=true
TQ_S3_AUTO_CREATE_BUCKET=true
TQ_SIGNED_URL_SECONDS=600
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-minio-password

# Durable render queue.
TQ_RENDER_ATTEMPTS=3
TQ_RENDER_CONCURRENCY=1
